# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
dist/
build/

# editor / OS cruft
.DS_Store
Thumbs.db
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig

# test coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# node-based tooling (none in this repo yet -- safety net for later, same
# reasoning as .venv/ above for Python)
node_modules/

# secrets (none in this repo -- safety net for later)
.env
.env.*
!.env.example
!ml/cad/.env.example

# generated model artifacts / data (regeneratable -- see docs/threedimen-architecture.md
# for the point-cloud model, scripts/train_program_model.py for program_model.joblib)
ml/cad/data/cad_v1/
ml/cad/checkpoints/
ml/cad/models/
ml/cad/webapp_output/
ml/cad/training/checkpoints/
ml/cad/training/data/
ml/cad/logs/
# user-ingested engineering reference documents + the knowledge/ subsystem's
# persistent index -- private, user-supplied, potentially licensed material;
# never committed (see knowledge/config.py). Test fixtures under
# tests/fixtures/ are NOT ignored -- they're small, authored-in-repo content.
ml/cad/knowledge_store/
*.joblib
*.stl
*.glb
!ml/cad/examples/*.stl
ml/threedimen/dataset/
ml/threedimen/data/
ml/threedimen/logs/
ml/threedimen/local_run/
*.npz
*.pt
*.zip
*.log

# local LLM weights (llm_decompose.py loads these from OUTSIDE the repo by
# default -- e.g. ~/Desktop/*.gguf -- this is a safety net in case one ever
# ends up inside the repo tree; multi-GB files like this must never be committed)
*.gguf
