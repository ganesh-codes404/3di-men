# Copy to .env (or export these directly) to override llm_decompose.py's
# defaults. Every one of these is optional -- omit any of them and the
# built-in default applies. See llm_decompose.py's module-level config block
# for exactly how each is used.

# Human-readable model name. Combined with QUANTIZATION to build the default
# MODEL_PATH (models/qwen/quantized/<MODEL_NAME>-<QUANTIZATION>.gguf) when
# MODEL_PATH itself is not set.
MODEL_NAME=Qwen3-4B-Instruct-2507

# Absolute or repo-relative path to the .gguf file. Set this to point at a
# different model entirely (e.g. the older Qwen3-1.7B-Q4_K_M.gguf) without
# touching MODEL_NAME/QUANTIZATION.
# MODEL_PATH=/Users/ganeshk/Desktop/Qwen3-1.7B-Q4_K_M.gguf

# Only "gguf" is implemented (loaded via llama-cpp-python). Present as an
# explicit setting, not silently assumed, so a future non-gguf backend has
# an obvious place to plug in.
MODEL_FORMAT=gguf

# Used only to build the default MODEL_PATH -- has no effect if MODEL_PATH
# is set explicitly.
QUANTIZATION=Q4_K_M

# Context window (tokens) passed to llama.cpp. Larger uses more RAM for the
# KV cache. The system prompt alone is currently ~3900 tokens (confirmed via
# the real tokenizer, not estimated) -- 8192 leaves comfortable headroom for
# the user's own prompt plus a multi-part JSON response. Re-check this with
# llm_decompose.py's own tokenizer (see MAX_CONTEXT's comment there) if
# _SYSTEM_PROMPT grows substantially; running too close to the ceiling causes
# silent decomposition failures, not just truncation (confirmed empirically).
MAX_CONTEXT=8192

# Default sampling temperature. decompose_prompt/ask_clarifying_questions
# each pass their own tuned temperature today (0.1 / 0.2) -- this is a
# fallback for future call sites that don't specify one.
TEMPERATURE=0.1

# GPU offload layer count passed to llama.cpp (0 = CPU-only, -1 = offload all
# layers). Defaults to 0. Leave this unset/0 on this Mac -- there is no
# dedicated GPU here. Only raise it on hardware with real GPU VRAM to spare
# (see .env.rtx4060.example for an NVIDIA-specific profile).
# N_GPU_LAYERS=0

# CPU thread count passed to llama.cpp. Unset uses llama.cpp's own internal
# default, which is appropriate for this machine's 2-core CPU. Leave this
# unset here; only set it explicitly on hardware with more cores to use.
# N_THREADS=
